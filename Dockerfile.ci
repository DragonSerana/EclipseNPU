# CI image: builds the pinned LLVM/MLIR + the toolchain + python test deps.
# The heavy LLVM build is cached by Docker layer cache (GitHub Actions gha cache),
# so only the first run pays the 40-60 min; subsequent runs reuse the layers.
FROM ubuntu:22.04

ARG LLVM_COMMIT=a67efda258fa73c7b6b915fb31b8412b800a15e9

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake ninja-build git python3 python3-pip \
      zlib1g-dev libncurses-dev libtinfo-dev \
    && rm -rf /var/lib/apt/lists/*

# LLVM/MLIR at the pinned commit, installed to /usr/local (so
# LLVM_INSTALL_DIR=/usr/local in CI). Heavy but cached.
RUN git clone https://github.com/llvm/llvm-project.git /llvm-project \
    && cd /llvm-project \
    && git checkout "${LLVM_COMMIT}" \
    && cmake -G Ninja -S llvm -B build \
         -DLLVM_ENABLE_PROJECTS=mlir \
         -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build -j"$(nproc)" \
    && cmake --install build

# Python deps for lit + accuracy_check. torch is optional; verify.py/accuracy_check
# fall back to a numpy reference when torch is absent.
RUN python3 -m pip install --no-cache-dir lit numpy
